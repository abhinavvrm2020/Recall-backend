# Copied into application.yml defaults; keep this file as a checklist of required env vars.
# Copy values into your shell or a local override — do not commit real secrets.

# PostgreSQL (required)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quizapp
DB_SCHEMA=public
DB_USER=abhinavverma
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=2

# Server
SERVER_PORT=8080

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=604800000

# Seed
SEED_ENABLED=true
SEED_ALLOTTED_TIME_MS=60000

# Logging
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=WARN
LOG_LEVEL_SQL_BIND=WARN
